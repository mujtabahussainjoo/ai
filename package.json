{
  "name": "myaibuddy",
  "version": "0.1.0",
  "private": true,
  "description": "MyAIBuddy monorepo - conversational AI, RAG, web research, and an all-rounder agent",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --stream dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "bash scripts/run-migrations.sh"
  },
  "devDependencies": {},
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}