# ===== MyAIBuddy backend environment =====
# Copy to .env and fill in. Never commit real secrets.

# Application
APP_NAME=MyAIBuddy
APP_ENV=development
APP_URL=http://localhost:8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=myaibuddy
POSTGRES_USER=myaibuddy
POSTGRES_PASSWORD=myaibuddy_dev
# Optional: full async connection string overrides the parts above
DATABASE_URL=

# Authentication and Security
# Dev only: a random secret is generated per-process if empty; use a fixed value so
# tokens survive restarts. Production MUST set a high-entropy secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# AI Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Search and External Tools
TAVILY_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# Optional Image Generation
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=myaibuddy
SENTRY_DSN=

# MCP
MCP_SERVER_URLS=
MCP_AUTH_TOKEN=

# RAG / embeddings
EMBEDDING_PROVIDER=keyword         # keyword | openai | huggingface | ollama
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=70
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.10
MAX_UPLOAD_MB=50
UPLOAD_DIR=var/uploads

# Rate limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=15/minute